# Optional override for the backend base URL.
# Leave empty by default: same-origin requests (/api/...) are forwarded by the
# dev-server proxy (VITE_DEV_PROXY_URL) or by nginx in production.
# Set it only when the API lives on a different origin — it is baked in at
# BUILD time (Vite replaces import.meta.env), so pass it as a build arg in CI/Docker:
#   docker build -f Dockerfile.prod --build-arg VITE_API_BASE_URL=https://api.example.com .
# IMPORTANT (D9): the API origin must also be added to ALLOWED_ORIGINS in the backend (R-15).
VITE_API_BASE_URL=